@model MoviesAdmin.Models.Movie

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Movie</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Title</dt>
        <dd class="col-sm-10">@Model.Title</dd>
        
        <dt class="col-sm-2">Synopsis</dt>
        <dd class="col-sm-10">@Model.Synopsis</dd>
        
        <dt class="col-sm-2">Genre</dt>
        <dd class="col-sm-10">@Model.Genre?.GenreName</dd>
        
        <dt class="col-sm-2">Rating</dt>
        <dd class="col-sm-10">@Model.Rating</dd>
        
        <dt class="col-sm-2">Runtime</dt>
        <dd class="col-sm-10">@Model.Runtime mins</dd>
        
        <dt class="col-sm-2">Director</dt>
        <dd class="col-sm-10">@Model.Director?.FullName</dd>
        
        <dt class="col-sm-2">Poster</dt>
        <dd class="col-sm-10">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="Poster" class="rounded shadow-sm" style="width: 80px; height: 120px; object-fit: cover;" />
            }
            else
            {
                <span>No Image</span>
            }
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>