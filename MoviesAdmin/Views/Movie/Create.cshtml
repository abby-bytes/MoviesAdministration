@model MoviesAdmin.Models.Movie

@{
    ViewData["Title"] = "Create Movie";
}

<h1 class="custom-header">Create Movie</h1>
<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Title" class="control-label fw-bold"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <!-- Laarge box for Synopsis -->
            <div class="form-group mb-3">
                <label asp-for="Synopsis" class="control-label fw-bold"></label>
                <textarea asp-for="Synopsis" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Synopsis" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Genre" class="control-label fw-bold"></label>
                    <input asp-for="Genre" class="form-control" />
                    <span asp-validation-for="Genre" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Rating" class="control-label fw-bold"></label>
                    <input asp-for="Rating" class="form-control" />
                    <span asp-validation-for="Rating" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Runtime" class="control-label fw-bold"></label>
                    <input asp-for="Runtime" class="form-control" />
                    <span asp-validation-for="Runtime" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Director" class="control-label fw-bold"></label>
                    <input asp-for="Director" class="form-control" />
                    <span asp-validation-for="Director" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
            </div>
        </form>
    </div>
</div>