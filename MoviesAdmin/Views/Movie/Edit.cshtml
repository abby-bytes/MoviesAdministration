@model MoviesAdmin.Models.Movie

@{
    ViewData["Title"] = "Edit Movie";
}

<h1 class="custom-header">Edit Movie</h1>
<hr />
<div class="row">
    <div class="col-md-8">
        <form asp-action="Edit" asp-route-id="@Model.Id" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ImageUrl" />

            <div class="form-group mb-3">
                <label asp-for="Title" class="control-label fw-bold"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Synopsis" class="control-label fw-bold"></label>
                <textarea asp-for="Synopsis" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Synopsis" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="GenreId" class="control-label fw-bold">Genre</label>
                    <select asp-for="GenreId" class="form-control" asp-items="ViewBag.GenreId">
                        <option value="">-- Select Genre --</option>
                    </select>
                    <span asp-validation-for="GenreId" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="AudienceRatingId" class="control-label">Audience Rating</label>
                    <select asp-for="AudienceRatingId" class="form-control" asp-items="ViewBag.AudienceRatingId">
                        <option value="">-- Select Audience Rating --</option>
                    </select>
                    <span asp-validation-for="AudienceRatingId" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Runtime" class="control-label fw-bold"></label>
                    <input asp-for="Runtime" class="form-control" />
                    <span asp-validation-for="Runtime" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="DirectorId" class="control-label fw-bold">Director</label>
                    <select asp-for="DirectorId" class="form-control" asp-items="ViewBag.DirectorId">
                        <option value="">-- Select Director --</option>
                    </select>
                    <span asp-validation-for="DirectorId" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="ReleaseDate" class="control-label fw-bold"></label>
                    <input asp-for="ReleaseDate" type="date" class="form-control" />
                    <span asp-validation-for="ReleaseDate" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group mb-4">
                <label class="control-label fw-bold">Update Poster Image (Optional)</label>
                <input type="file" name="imageFile" class="form-control" />
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <div class="mt-2">
                        <small class="text-muted">Current Poster:</small><br />
                        <img src="@Model.ImageUrl" alt="Current Poster" class="img-thumbnail mt-1" style="width: 80px; height: 120px; object-fit: cover;" />
                    </div>
                }
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Save Changes" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
            </div>
        </form>
    </div>
</div>