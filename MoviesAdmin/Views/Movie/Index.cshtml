@model IEnumerable<MoviesAdmin.Models.Movie>

@{
    ViewData["Title"] = "Movies";
}

<h1 class="custom-header">Movies</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<div class="movie-list">
@foreach (var item in Model) {
    <div class="movie-card mb-4 p-3 border rounded shadow-sm">
        <!-- 1. Bigger Title -->
        <h2 class="movie-title mb-2">
            @Html.DisplayFor(model => item.Title)
        </h2>

        <!-- 2. Synopsis block with Rating on the same line/row -->
        <div class="d-flex justify-content-between align-items-start mb-2">
            <p class="movie-synopsis mb-0 me-3">
                @Html.DisplayFor(model => item.Synopsis)
            </p>
            <span class="badge bg-warning text-dark fs-6">
                @Html.DisplayFor(model => item.Rating)
            </span>
        </div>

        <hr />

        <!-- 3. Line break below: Runtime, Director, Genre -->
        <div class="movie-details mb-2">
            <strong>Runtime:</strong> @Html.DisplayFor(model => item.Runtime) mins &nbsp;|&nbsp;
            <strong>Director:</strong> @Html.DisplayFor(model => item.Director) &nbsp;|&nbsp;
            <strong>Genre:</strong> @Html.DisplayFor(model => item.Genre)
        </div>

        <hr />

        <!-- 4. Action Links -->
        <div class="movie-actions">
            <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
            <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
            <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
        </div>
    </div>
}
</div>