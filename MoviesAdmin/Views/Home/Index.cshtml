@model IEnumerable<MoviesAdmin.Models.Movie>

@{
    ViewData["Title"] = "Popcorn Picks - Home";
}

<div class="text-center mb-5">
    <h1 class="custom-header display-4 fw-bold">Popcorn Picks</h1>
    <p class="lead text-muted">Explore our movie collections below!</p>
</div>

<div class="container">
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-12">
                <div class="card shadow-sm border-0 rounded-3 p-3 bg-white">
                    <div class="row g-0 align-items-center">
                        <div class="col-md-2 text-center">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="@item.Title Poster" class="img-fluid rounded shadow-sm" style="width: 120px; height: 180px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="bg-light border text-center d-flex align-items-center justify-content-center text-muted rounded mx-auto" style="width: 120px; height: 180px;">
                                    <small>No Image</small>
                                </div>
                            }
                        </div>

                        <!-- Movie Info Column -->
                        <div class="col-md-10">
                            <div class="card-body py-2">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h3 class="card-title fw-bold text-dark mb-0">@item.Title</h3>
                                    <span class="badge bg-secondary">@item.AudienceRating?.Title</span>
                                </div>

                                <p class="card-text text-muted mb-3 text-truncate" style="max-width: 800px;">
                                    @item.Synopsis
                                </p>

                                <p class="small text-muted mb-3">
                                    <strong>Genre:</strong> @item.Genre &nbsp;|&nbsp;
                                    <strong>Runtime:</strong> @item.Runtime mins &nbsp;|&nbsp;
                                    <strong>Released:</strong> @item.ReleaseDate.ToShortDateString()
                                </p>

                                <a asp-controller="Movie" asp-action="Details" asp-route-id="@item.Id" asp-route-fromHome="true" class="btn btn-outline-dark btn-sm rounded-pill px-4">
                                    View Details 
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>